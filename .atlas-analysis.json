{
  "projectType": "cli-tool",
  "projectName": "vdpm",
  "projectDescription": "vdpm is the VitaSDK package manager — a cross-platform CLI tool for installing, removing, upgrading, and managing SDK packages for PlayStation Vita homebrew development.",
  "theme": "aspen",
  "primaryColor": "#0057B8",
  "lightColor": "#3A82E4",
