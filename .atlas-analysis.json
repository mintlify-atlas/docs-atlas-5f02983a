  "keyFeatures": [
    "Cross-platform SDK package manager (Linux, macOS, FreeBSD, Windows)",
    "Ed25519-signed channel manifests with SHA-256 verified package databases",
    "Bootstrap script installs the full VitaSDK toolchain from scratch",
    "Release series (channels) management with nightly and stable support",
    "Pacman-backed transaction engine with rootless (non-root) installation",
    "Native C frontend with no dependency on bash or libalpm on Windows",
    "Atomic channel refresh: staged manifest committed only after successful transaction",
    "Automatic host triplet detection for Linux (glibc/musl), macOS, FreeBSD, Windows"
  ],
  "publicApiSurface": [
    "vdpm install [--force] PACKAGE...",
    "vdpm remove PACKAGE...",
    "vdpm upgrade [PACKAGE...]",
    "vdpm list [PACKAGE...]",
    "vdpm search TERM...",
    "vdpm info PACKAGE...",
    "vdpm files PACKAGE...",
    "vdpm refresh SERIES",
    "vdpm channels",
    "vdpm status",
    "vdpm pacman [--] ARG...",
    "bootstrap-vitasdk.sh [--install-dir PATH] [--url URL] [--sha256 HEX]",
    "bootstrap-vitasdk.ps1 [-InstallDirectory PATH] [-Url URL] [-Sha256 HEX]",
    "VITASDK (env var: SDK root path)",
    "VITASDK_CHANNEL (env var: release series name)",
    "VITASDK_BOOTSTRAP_URL (env var: explicit archive URL)",
    "VITASDK_BOOTSTRAP_SHA256 (env var: archive hash)",
    "VDPM_NONINTERACTIVE (env var: suppress prompts)",
    "VDPM_PACMAN (env var: override pacman binary path)",
    "VDPM_PACMAN_CONF (env var: override pacman.conf path)"
  ]
}
